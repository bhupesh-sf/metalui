{
  "$schema": "metalui/rig@1",
  "name": "storage",
  "title": "Storage",
  "job": "keep",
  "feel": {
    "v": 0.6,
    "a": 0.2,
    "w": 0.4
  },
  "grid": [
    3,
    1
  ],
  "gadgets": {
    "local": {
      "gadget": "drawer",
      "at": [
        0,
        0
      ]
    },
    "used": {
      "gadget": {
        "$schema": "metalui/gadget@1",
        "name": "used-gauge",
        "title": "Used",
        "job": "signal",
        "feel": {
          "v": 0.6,
          "a": 0.5,
          "w": 0.45
        },
        "container": "inset",
        "station": 55,
        "material": "metal",
        "parts": [
          {
            "id": "body",
            "part": "bezel",
            "at": [
              200,
              196
            ],
            "size": [
              320,
              320
            ],
            "role": "body",
            "params": {
              "width": 22,
              "face": "glass-face"
            }
          },
          {
            "id": "face",
            "part": "glass-face",
            "at": [
              200,
              196
            ],
            "size": [
              276,
              276
            ],
            "role": "trim"
          },
          {
            "id": "lamp",
            "part": "led",
            "at": [
              313,
              78
            ],
            "role": "lamp"
          },
          {
            "id": "needle",
            "part": "needle",
            "at": [
              200,
              220
            ],
            "role": "actor",
            "params": {
              "arc": 120,
              "ticks": 9,
              "threshold": 0.9
            }
          },
          {
            "id": "beeper",
            "part": "beeper",
            "at": [
              84,
              322
            ],
            "role": "trim",
            "params": {
              "slots": 3
            }
          }
        ],
        "mechanism": {
          "name": "swing",
          "bind": {
            "needle": "needle",
            "face": "face",
            "lamp": "lamp",
            "beeper": "beeper"
          },
          "drive": "value"
        },
        "ports": {
          "in": {
            "value": {
              "kind": "number",
              "min": 0,
              "max": 100,
              "unit": "%",
              "default": 50
            }
          },
          "out": {
            "over": {
              "kind": "pulse"
            },
            "above": {
              "kind": "boolean"
            }
          }
        },
        "states": {
          "rest": {
            "lamp": [
              "off",
              "steady"
            ]
          },
          "over": {
            "lamp": [
              "waiting",
              "steady"
            ],
            "beep": "waiting"
          }
        },
        "describe": "{title}: {value}{unit}"
      },
      "at": [
        1,
        0
      ]
    },
    "trash": {
      "gadget": "lidded-bin",
      "at": [
        2,
        0
      ]
    }
  },
  "cables": [
    {
      "from": "local.fill",
      "to": "used.value",
      "map": {
        "kind": "scale",
        "from": [
          0,
          1
        ],
        "to": [
          0,
          100
        ]
      }
    },
    {
      "from": "used.above",
      "to": "trash.armed"
    }
  ]
}
