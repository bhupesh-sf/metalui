{
  "$schema": "metalui/rig@1",
  "name": "capture",
  "title": "Capture",
  "job": "take",
  "feel": {
    "v": 0.8,
    "a": 0.6,
    "w": 0.3
  },
  "grid": [
    3,
    1
  ],
  "gadgets": {
    "take": {
      "gadget": "shutter-lens",
      "at": [
        0,
        0
      ]
    },
    "today": {
      "gadget": "counter-drum",
      "at": [
        1,
        0
      ]
    },
    "memory": {
      "gadget": "cell-grid",
      "at": [
        2,
        0
      ]
    }
  },
  "cables": [
    {
      "from": "take.taken",
      "to": "today.count",
      "map": {
        "kind": "count",
        "step": 1
      }
    },
    {
      "from": "today.count",
      "to": "memory.fill",
      "map": {
        "kind": "scale",
        "from": [
          0,
          20
        ],
        "to": [
          0,
          1
        ]
      }
    }
  ]
}
