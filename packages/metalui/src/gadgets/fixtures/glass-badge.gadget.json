{
  "$schema": "metalui/gadget@1",
  "name": "glass-badge", "title": "Account",
  "job": "identify", "feel": { "v": 0.6, "a": 0.2, "w": 0.9 }, "container": "inset", "station": 260, "material": "metal",
  "parts": [
    { "id": "body",  "part": "bezel",      "at": [200, 196], "size": [320, 320], "role": "body", "params": { "width": 22, "face": "glass-face", "opening": "square" } },
    { "id": "face",  "part": "glass-face", "at": [200, 196], "size": [276, 276], "role": "trim" },
    { "id": "light", "part": "backlight",  "at": [200, 196], "size": [276, 276], "role": "trim", "params": { "shape": "glow", "color": "glass" } },
    { "id": "mark",  "part": "glyph",      "at": [200, 204], "size": [132, 132], "role": "trim", "params": { "name": "friend" } },
    { "id": "lamp",  "part": "led",        "at": [313, 78],  "role": "lamp" }
  ],
  "mechanism": { "name": "glow", "bind": { "light": "light", "lamp": "lamp" }, "drive": "signed-in" },
  "ports": { "in": { "signed-in": { "kind": "boolean", "default": false } } },
  "states": {
    "rest":      { "lamp": ["off", "steady"], "hint": "signed out" },
    "signed-in": { "lamp": ["live", "rise"], "hint": "signed in" },
    "expired":   { "lamp": ["waiting", "steady"], "hint": "sign in again" }
  },
  "describe": "{title}"
}
