{
  "$schema": "metalui/rig@1",
  "name": "canvas-status",
  "title": "Canvas status",
  "job": "find",
  "feel": {
    "v": 0.6,
    "a": 0.5,
    "w": 0.3
  },
  "grid": [
    3,
    1
  ],
  "gadgets": {
    "find": {
      "gadget": "scope",
      "at": [
        1,
        0
      ]
    },
    "blocks": {
      "gadget": "counter-drum",
      "at": [
        2,
        0
      ]
    },
    "when": {
      "gadget": "thumbwheel",
      "at": [
        0,
        0
      ]
    }
  },
  "cables": [
    {
      "from": "find.found",
      "to": "blocks.count"
    },
    {
      "from": "when.in-past",
      "to": "find.query",
      "map": {
        "kind": "select",
        "table": {
          "true": false,
          "false": true
        }
      }
    }
  ]
}
