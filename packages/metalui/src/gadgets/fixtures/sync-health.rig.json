{
  "$schema": "metalui/rig@1",
  "name": "sync-health",
  "title": "Sync health",
  "job": "link",
  "feel": {
    "v": 0.7,
    "a": 0.5,
    "w": 0.4
  },
  "grid": [
    2,
    2
  ],
  "gadgets": {
    "sync": {
      "gadget": "patch-bay",
      "at": [
        0,
        0
      ]
    },
    "health": {
      "gadget": {
        "$schema": "metalui/gadget@1",
        "name": "health-gauge",
        "title": "Health",
        "job": "signal",
        "feel": {
          "v": 0.6,
          "a": 0.5,
          "w": 0.45
        },
        "container": "inset",
        "station": 55,
        "material": "metal",
        "parts": [
          {
            "id": "body",
            "part": "bezel",
            "at": [
              200,
              196
            ],
            "size": [
              320,
              320
            ],
            "role": "body",
            "params": {
              "width": 22,
              "face": "glass-face"
            }
          },
          {
            "id": "face",
            "part": "glass-face",
            "at": [
              200,
              196
            ],
            "size": [
              276,
              276
            ],
            "role": "trim"
          },
          {
            "id": "lamp",
            "part": "led",
            "at": [
              313,
              78
            ],
            "role": "lamp"
          },
          {
            "id": "needle",
            "part": "needle",
            "at": [
              200,
              220
            ],
            "role": "actor",
            "params": {
              "arc": 120,
              "ticks": 9
            }
          },
          {
            "id": "beeper",
            "part": "beeper",
            "at": [
              84,
              322
            ],
            "role": "trim",
            "params": {
              "slots": 3
            }
          }
        ],
        "mechanism": {
          "name": "swing",
          "bind": {
            "needle": "needle",
            "face": "face",
            "lamp": "lamp",
            "beeper": "beeper"
          },
          "drive": "value"
        },
        "ports": {
          "in": {
            "value": {
              "kind": "number",
              "min": 0,
              "max": 100,
              "unit": "%",
              "default": 50
            }
          }
        },
        "states": {
          "rest": {
            "lamp": [
              "off",
              "steady"
            ]
          }
        },
        "describe": "{title}: {value}{unit}"
      },
      "at": [
        1,
        0
      ]
    },
    "pending": {
      "gadget": "counter-drum",
      "at": [
        1,
        1
      ]
    }
  },
  "cables": [
    {
      "from": "sync.healthy",
      "to": "health.value",
      "map": {
        "kind": "select",
        "table": {
          "false": 10,
          "true": 90
        }
      }
    },
    {
      "from": "sync.done",
      "to": "pending.count",
      "map": {
        "kind": "count",
        "step": -1
      }
    }
  ]
}
