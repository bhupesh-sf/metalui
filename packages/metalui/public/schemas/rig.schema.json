{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metalui.dev/schemas/rig.schema.json",
  "title": "MetalUI rig spec (metalui/rig@1)",
  "description": "A rig: gadgets on a grid in one panel, wired by patch cables from out ports to in ports. validateRig checks kinds, cycles, fan-out and the set rules.",
  "type": "object",
  "required": [
    "$schema",
    "name",
    "title",
    "job",
    "feel",
    "grid",
    "gadgets",
    "cables"
  ],
  "properties": {
    "$schema": {
      "const": "metalui/rig@1"
    },
    "name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "job": {
      "enum": [
        "tune",
        "command",
        "link",
        "keep",
        "identify",
        "destroy",
        "take",
        "find",
        "make",
        "signal"
      ]
    },
    "feel": {
      "type": "object",
      "required": [
        "v",
        "a",
        "w"
      ],
      "properties": {
        "v": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "a": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "w": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "grid": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "gadgets": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 8,
      "additionalProperties": {
        "type": "object",
        "required": [
          "gadget",
          "at"
        ],
        "properties": {
          "gadget": {
            "oneOf": [
              {
                "enum": [
                  "patch-bay",
                  "fader-bank",
                  "keycap-chord",
                  "scope",
                  "drawer",
                  "lidded-bin",
                  "shutter-lens",
                  "counter-drum",
                  "cell-grid",
                  "needle-gauge",
                  "rocker",
                  "ink-well",
                  "thumbwheel",
                  "glass-badge"
                ]
              },
              {
                "$ref": "https://metalui.dev/schemas/gadget.schema.json"
              }
            ]
          },
          "at": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          },
          "set": {
            "type": "object"
          }
        }
      }
    },
    "cables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
          },
          "map": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "threshold",
                  "scale",
                  "match",
                  "count",
                  "select"
                ]
              }
            }
          }
        }
      }
    }
  }
}
